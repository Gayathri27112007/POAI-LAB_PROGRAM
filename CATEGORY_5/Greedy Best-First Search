import heapq

# Initial state: (Missionaries, Cannibals, Boat)
start = (3, 3, 1)

# Goal state
goal = (0, 0, 0)

# Possible boat movements
moves = [
    (1, 0), (2, 0),
    (0, 1), (0, 2),
    (1, 1)
]

# Check valid state
def valid(m, c):

    if m < 0 or c < 0 or m > 3 or c > 3:
        return False

    # Left bank
    if m > 0 and c > m:
        return False

    # Right bank
    mr = 3 - m
    cr = 3 - c

    if mr > 0 and cr > mr:
        return False

    return True


# Greedy Best First Search
def greedy_bfs():

    pq = []
    heapq.heappush(pq, (6, start, [start]))

    visited = set()

    while pq:

        h, state, path = heapq.heappop(pq)

        if state == goal:
            return path

        if state in visited:
            continue

        visited.add(state)

        m, c, boat = state

        for x, y in moves:

            if boat == 1:
                new_state = (m-x, c-y, 0)
            else:
                new_state = (m+x, c+y, 1)

            if valid(new_state[0], new_state[1]):

                if new_state not in visited:

                    heuristic = new_state[0] + new_state[1]

                    heapq.heappush(
                        pq,
                        (heuristic, new_state, path + [new_state])
                    )

    return None


# Main program
solution = greedy_bfs()

if solution:

    print("Solution Path:")

    for step in solution:
        print(step)

    print("Total Steps:", len(solution)-1)

else:
    print("No solution found")
