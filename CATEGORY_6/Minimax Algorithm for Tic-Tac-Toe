# Tic-Tac-Toe using Minimax

board = [' ' for i in range(9)]

# Display board
def display():
    print()
    for i in range(0, 9, 3):
        print(board[i], "|", board[i+1], "|", board[i+2])
        if i < 6:
            print("---------")
    print()


# Check winner
def winner(player):

    win = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]

    for w in win:
        if all(board[i] == player for i in w):
            return True

    return False


# Minimax algorithm
def minimax(is_max):

    if winner('O'):
        return 1

    if winner('X'):
        return -1

    if ' ' not in board:
        return 0

    if is_max:

        best = -100

        for i in range(9):

            if board[i] == ' ':
                board[i] = 'O'

                score = minimax(False)

                board[i] = ' '

                best = max(best, score)

        return best

    else:

        best = 100

        for i in range(9):

            if board[i] == ' ':
                board[i] = 'X'

                score = minimax(True)

                board[i] = ' '

                best = min(best, score)

        return best


# Find best move for AI
def best_move():

    best_score = -100
    move = -1

    for i in range(9):

        if board[i] == ' ':

            board[i] = 'O'

            score = minimax(False)

            board[i] = ' '

            if score > best_score:
                best_score = score
                move = i

    return move


# Main program
while True:

    display()

    # Human move
    pos = int(input("Enter position (1-9): ")) - 1

    if pos < 0 or pos > 8 or board[pos] != ' ':
        print("Invalid position! Try again.")
        continue

    board[pos] = 'X'

    if winner('X'):
        display()
        print("Human Wins!")
        break

    if ' ' not in board:
        display()
        print("Game Draw!")
        break

    # AI move
    ai = best_move()
    board[ai] = 'O'

    print("AI selected position:", ai + 1)

    if winner('O'):
        display()
        print("AI Wins!")
        break

    if ' ' not in board:
        display()
        print("Game Draw!")
        break
